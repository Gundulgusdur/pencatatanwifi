generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Package {
  id        Int      @id @default(autoincrement())
  packageName String  @db.VarChar(50)
  bandwidth  String  @db.VarChar(20)
  price      Decimal @db.Decimal(10, 2)
  customers  Customer[]

  @@map("packages")
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  whatsapp    String   @db.VarChar(20)
  ipAddress   String?  @db.VarChar(50)
  packageId   Int
  dueDateDay  Int
  status      String   @default("active") @db.VarChar(20) // 'active' | 'isolated' | 'inactive'
  package     Package  @relation(fields: [packageId], references: [id])
  invoices    Invoice[]

  @@map("customers")
}

model Invoice {
  id            Int      @id @default(autoincrement())
  customerId    Int
  billingPeriod String   @db.VarChar(7) // YYYY-MM
  amount        Decimal  @db.Decimal(10, 2)
  status        String   @default("unpaid") @db.VarChar(20) // 'unpaid' | 'paid'
  paidAt        DateTime?
  customer      Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, billingPeriod])
  @@map("invoices")
}
